# Credenciales de Supabase.
#
# Copia este archivo a `.env` y rellena los dos valores. `.env` está en
# .gitignore: nunca se sube al repositorio.
#
# Dónde encontrarlos: panel de Supabase → tu proyecto → Settings → API.
#
# El prefijo EXPO_PUBLIC_ hace que Expo los incruste en el bundle, así que
# ambos acaban siendo visibles en la app. Es lo esperado: la clave "anon" está
# diseñada para ser pública y quien protege los datos es RLS, no el secreto de
# la clave.
#
# NUNCA pongas aquí la clave `service_role`. Esa se salta RLS por completo y
# solo debe vivir en un servidor, jamás en la app.

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA
